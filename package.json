    "test:api-routes": "node scripts/test-api-route-coverage.mjs",
    "test:backup": "node scripts/test-backup-contract.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:integration": "node scripts/test-desktop-runtime-config.mjs",
    "test:windows": "node scripts/test-windows-contract.mjs",
    "test:desktop-sqlite": "node scripts/test-desktop-sqlite-bootstrap.mjs",
    "test:desktop-sqlite-regression": "node --disable-warning=ExperimentalWarning scripts/test-desktop-sqlite-regression.mjs",
    "test:desktop-hardening": "node scripts/test-desktop-hardening-contract.mjs",
    "test:release-artifacts": "node scripts/test-release-artifacts.mjs",
    "test:license": "node scripts/test-license-flow.mjs",
    "test:offline": "node scripts/test-offline-contract.mjs",
    "test:local-lists": "node scripts/test-local-list-contract.mjs",
    "test:invoice-print": "node scripts/test-invoice-print-contract.mjs",
    "test:final-offline-network": "node scripts/test-final-offline-network.mjs",
    "test:final-offline-exports": "tsx scripts/test-final-offline-exports.ts",
    "test:performance": "node scripts/test-performance-contract.mjs",
    "generate-license-keys": "node scripts/generate-license-keys.mjs",
    "license:keys": "node scripts/generate-license-keys.mjs",
    "tauri": "tauri",
    "desktop:prepare": "node scripts/prepare-desktop-build.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:build:mac": "node scripts/build-desktop.mjs --bundles dmg",
    "desktop:build:mac:public": "node scripts/build-desktop.mjs --public-mac --bundles dmg",
    "desktop:build:windows": "node scripts/build-desktop.mjs --bundles msi,nsis",
    "desktop:build:windows:public": "node scripts/build-desktop.mjs --public-windows --bundles msi,nsis",
    "desktop:package:windows:portable": "node scripts/build-windows-portable.mjs",
