    "@tauri-apps/api": "^2.11.1",
    "@types/three": "^0.184.1",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "three": "^0.184.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.3.6"
