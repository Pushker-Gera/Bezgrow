NEXT_PUBLIC_SITE_URL=https://www.bezgrow.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Raw base64url Ed25519 keys. Generate with: npm run generate-license-keys
# Paste the printed values without PEM headers or quotes.
BEZGROW_LICENSE_PRIVATE_KEY=
NEXT_PUBLIC_BEZGROW_LICENSE_PUBLIC_KEY=

# Optional for desktop builds. Defaults to NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_DESKTOP_API_ORIGIN=https://www.bezgrow.com
# Hosted online-only Platform Administration origin. Never point a production
# desktop build at its bundled localhost server.
NEXT_PUBLIC_ADMIN_APP_URL=https://www.bezgrow.com
BEZGROW_ADMIN_ORIGIN=https://www.bezgrow.com
# Hosted origin used for authenticated, explicit online actions such as secure invoice links.
# It must run the current Next.js API with SUPABASE_SERVICE_ROLE_KEY set server-side.

# Optional, server-only WhatsApp Business Cloud API configuration. The value is
# a JSON object keyed by the signed Bezgrow business ID. Never expose this as a
# NEXT_PUBLIC variable or place it in a desktop build.
# Example (single line):
# {"business-id":{"phoneNumberId":"123456789012345","accessToken":"server-only-token","graphApiVersion":"v25.0","senderLabel":"Business WhatsApp"}}
BEZGROW_WHATSAPP_BUSINESS_CONFIG_JSON=
