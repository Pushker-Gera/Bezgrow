{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop permissions for Bezgrow ERP",
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "windows": ["main", "startup-error"],
  "permissions": [
    "core:default",
    "updater:default",
    "allow-desktop-database-diagnostics",
    "allow-desktop-database-backup",
    "allow-desktop-prepare-update",
    "allow-desktop-cancel-update-preparation",
    "allow-desktop-restart-after-update",
    "allow-desktop-execute",
    "allow-desktop-select",
    "allow-desktop-execute-transaction",
    "allow-desktop-startup-log",
    "allow-store-secret",
    "allow-read-secret",
    "allow-delete-secret",
    "allow-desktop-get-or-create-device-id",
    "allow-desktop-platform-admin-proof",
    "allow-desktop-prepare-invoice-share",
    "allow-desktop-save-file",
    "allow-desktop-pick-business-logo",
    "allow-desktop-remove-business-logo",
    "allow-desktop-read-local-asset",
    "allow-desktop-open-pdf-for-print",
    "allow-desktop-reveal-file",
    "allow-desktop-open-file",
    "allow-desktop-export-backup",
    "allow-desktop-restore-backup",
    "allow-desktop-exit",
    "allow-desktop-retry-startup",
    "allow-open-external-url",
    "allow-open-platform-admin"
  ]
}
